# ──────────────────────────────────────────────
# Internet Research Assistant – Environment Config
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# OpenAI (required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Search settings
MAX_SEARCH_RESULTS=5
SEARCH_TIMEOUT=10
MAX_CONCURRENT_SEARCHES=3

# Cache settings
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=100

# Database
DB_PATH=research_assistant.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=research_assistant.log
